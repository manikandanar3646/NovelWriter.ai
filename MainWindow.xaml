
<Window x:Class="AI_Novel_writing_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MythForge — AI Novel Writing System"
        Width="1536" Height="980" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#050A13"
        Foreground="#EEE5D4"
        FontFamily="Georgia">

    <Window.Resources>
        <SolidColorBrush x:Key="Gold" Color="#D5AD70"/>
        <SolidColorBrush x:Key="GoldDark" Color="#8E7047"/>
        <SolidColorBrush x:Key="Panel" Color="#080F1B"/>
        <SolidColorBrush x:Key="Panel2" Color="#0C1624"/>
        <SolidColorBrush x:Key="Line" Color="#30303A"/>
        <SolidColorBrush x:Key="Ivory" Color="#EEE5D4"/>
        <SolidColorBrush x:Key="Muted" Color="#A8A6A3"/>

        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Foreground" Value="{StaticResource Ivory}"/>
            <Setter Property="Background" Value="#111A28"/>
            <Setter Property="BorderBrush" Value="#48413A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="NavButton"
               BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A111D"/>
            <Setter Property="Foreground" Value="{StaticResource Ivory}"/>
            <Setter Property="BorderBrush" Value="#38343A"/>
            <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111927"/>
            <Setter Property="Foreground" Value="{StaticResource Ivory}"/>
            <Setter Property="BorderBrush" Value="#4A4136"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#050A13"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="390"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="❧" FontSize="42" Foreground="{StaticResource Gold}"
                               Margin="2,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MythForge" FontSize="25"
                                   Foreground="{StaticResource Gold}"/>
                        <TextBlock Text="AI Novel Writing System" FontSize="12"
                                   Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="◎  World Builder" Click="WorldBuilder_Click"/>
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="♙  Character Design" Click="Characters_Click"/>
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="♧  Plot Connections" Click="PlotConnections_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="☁  OpenAI" Click="SelectOpenAI_Click"/>
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="▱  Local AI" Click="SelectLocalAI_Click"/>
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="⚙" Padding="9,8" Click="Settings_Click"/>
                    <TextBlock Text="☼  −  □  ×" Foreground="{StaticResource Gold}"
                               FontSize="17" VerticalAlignment="Center" Margin="8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOUR-PANEL WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="226"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="396"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION -->
            <Border Grid.Column="0" Background="#070E19"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="5,2,5,12">
                        <TextBlock Text="My Novels" FontSize="16"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="⌄" FontSize="18" Foreground="{StaticResource Gold}"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>

                    <ComboBox x:Name="NovelSelector" Grid.Row="1"
                              Height="38" Margin="0,0,0,15"
                              SelectionChanged="NovelSelector_SelectionChanged"
                              DisplayMemberPath="Title"/>

                    <StackPanel Grid.Row="2">
                        <Button Style="{StaticResource NavButton}" Content="⌂   Dashboard"
                                Click="Dashboard_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▤   Novel Overview"
                                Click="NovelOverview_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▣   Chapters"
                                Background="#30291F" BorderBrush="{StaticResource GoldDark}"
                                Click="Chapters_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="♙   Characters"
                                Click="Characters_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◎   World Building"
                                Click="WorldBuilder_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="☷   Timeline"
                                Click="Timeline_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="♧   Plot Threads"
                                Click="PlotConnections_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▤   Research Notes"
                                Click="ResearchNotes_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙   Settings"
                                Click="Settings_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Text="“Better a thousand&#10;imperfect words&#10;than a single perfect&#10;silence.”"
                               FontStyle="Italic" FontSize="12"
                               Foreground="{StaticResource Gold}"
                               Margin="4,12,4,20"/>
                </Grid>
            </Border>

            <!-- CHAPTER TREE -->
            <Border Grid.Column="1" Background="#09111E"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"
                    Padding="9,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock Text="Chapters" FontSize="17"
                                   VerticalAlignment="Center"/>
                        <Button Content="+" Padding="8,2" DockPanel.Dock="Right"
                                Click="NewChapter_Click"/>
                    </DockPanel>

                    <TextBlock x:Name="ChapterSubheading" Grid.Row="1"
                               Text="Select a novel" FontSize="11"
                               Foreground="{StaticResource Muted}" Margin="2,8"/>

                    <ListBox x:Name="ChapterList" Grid.Row="2"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Ivory}"
                             SelectionChanged="ChapterList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,9"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Foreground" Value="{StaticResource Ivory}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" CornerRadius="7"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background" Value="#30291F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ChapterNumber,
                                        StringFormat=Chapter {0}}"
                                        FontSize="10" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- MANUSCRIPT EDITOR -->
            <Grid Grid.Column="2" Margin="7,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="47"/>
                    <RowDefinition Height="47"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <Border Background="#111722" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="10,5">
                    <DockPanel>
                        <TextBlock x:Name="CurrentChapterTitle"
                                   Text="Chapter 1 — The Forgotten City"
                                   VerticalAlignment="Center" FontSize="14"
                                   Foreground="{StaticResource Ivory}"/>
                        <Button Content="+" Padding="8,2" DockPanel.Dock="Right"
                                Click="NewChapter_Click"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="#101722"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="7" Margin="0,4,0,4">
                    <DockPanel Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="↶" Padding="8,4" Click="Undo_Click"/>
                            <Button Content="↷" Padding="8,4" Click="Redo_Click"/>
                            <ComboBox x:Name="FontFamilySelector" Width="95"
                                      SelectedIndex="0" Margin="3">
                                <ComboBoxItem Content="Serif"/>
                                <ComboBoxItem Content="Georgia"/>
                                <ComboBoxItem Content="Times New Roman"/>
                            </ComboBox>
                            <ComboBox x:Name="FontSizeSelector" Width="55"
                                      SelectedIndex="2" SelectionChanged="FontSize_SelectionChanged">
                                <ComboBoxItem Content="12"/>
                                <ComboBoxItem Content="14"/>
                                <ComboBoxItem Content="16"/>
                                <ComboBoxItem Content="18"/>
                                <ComboBoxItem Content="20"/>
                            </ComboBox>
                            <Button Content="B" FontWeight="Bold" Click="Bold_Click"/>
                            <Button Content="I" FontStyle="Italic" Click="Italic_Click"/>
                            <Button Content="U" Click="Underline_Click"/>
                            <Button Content="☰" Click="AlignLeft_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    DockPanel.Dock="Right">
                            <TextBlock x:Name="WordCountLabel" Text="Words: 0"
                                       VerticalAlignment="Center" Margin="7"
                                       FontSize="12"/>
                            <TextBlock Text="●" Foreground="#6BCB8B"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="SaveStatusLabel" Text="Save"
                                       VerticalAlignment="Center" Margin="5"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" CornerRadius="5" BorderBrush="#40352B"
                        BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#241E19" Offset="0"/>
                                <GradientStop Color="#171715" Offset="0.52"/>
                                <GradientStop Color="#111720" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <TextBox x:Name="ManuscriptEditor"
                                 Margin="25,25,25,15"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#F1E9DC" FontFamily="Georgia"
                                 FontSize="17" TextWrapping="Wrap"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 SpellCheck.IsEnabled="True"
                                 TextChanged="ManuscriptEditor_TextChanged"/>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="3" Margin="4,3">
                    <TextBlock x:Name="AutosaveLabel" Text="♧  Ready"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource Muted}"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="▤" Padding="6,3"/>
                        <Button Content="♧  Scene Mode  ⌄" Padding="8,3"
                                Click="SceneMode_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- AI COMPANION -->
            <Border Grid.Column="3" Background="#070E19"
                    BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="88"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock Text="☏  AI Companion" FontSize="18"
                                   Foreground="{StaticResource Gold}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="⌁   ×" FontSize="17"
                                   Foreground="{StaticResource Gold}"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto" Margin="0,5">
                        <StackPanel x:Name="ChatMessages">
                            <Border Background="#111B29" CornerRadius="10"
                                    Padding="13" Margin="4,5,12,12">
                                <StackPanel>
                                    <TextBlock Text="Welcome back! ☺"
                                               Foreground="{StaticResource Gold}"
                                               Margin="0,0,0,7"/>
                                    <TextBlock Text="I'm your AI writing assistant. I'll use your world, characters, and plot information to help you create a consistent and engaging story.&#10;&#10;What would you like to do today?"
                                               TextWrapping="Wrap" LineHeight="21"/>
                                    <TextBlock Text="10:24 AM" FontSize="9"
                                               Foreground="{StaticResource Muted}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,5,0,8">
                        <WrapPanel>
                            <Button Content="Continue the story" Click="ContinueStory_Click"/>
                            <Button Content="Add dialogue" Click="AddDialogue_Click"/>
                            <Button Content="Make it darker" Click="MakeDarker_Click"/>
                            <Button Content="Change the setting" Click="ChangeSetting_Click"/>
                            <Button Content="Give more detail" Click="GiveMoreDetail_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="3" BorderBrush="#48413A"
                            BorderThickness="1" CornerRadius="8"
                            Background="#090F19" Padding="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInput"
                                     Background="Transparent" BorderThickness="0"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Type your message..."/>
                            <Button Grid.Column="1" Content="➤"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource Gold}"
                                    Click="SendMessage_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
