<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="darkFanNovel.MainWindow"
        Title="Dark Fan Novel"
        Background="#080808"
        WindowStartupLocation="CenterScreen" Height="578" Width="1137">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================= -->
        <!-- MAIN AREA -->
        <!-- ========================================= -->

        <Grid Grid.Row="0">

            <!-- ========================================= -->
            <!-- LEFT SIDE -->
            <!-- ========================================= -->

            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="40,0,0,0"
                        Panel.ZIndex="2">

                <StackPanel.Resources>

                    <Style TargetType="{x:Type Button}">

                        <Setter Property="Width"
                                Value="130"/>

                        <Setter Property="Height"
                                Value="35"/>

                        <Setter Property="Background"
                                Value="#D4AF37"/>

                        <Setter Property="Foreground"
                                Value="#1A1A1A"/>

                        <Setter Property="FontWeight"
                                Value="ExtraBold"/>

                        <Setter Property="Margin"
                                Value="0,8"/>

                        <Setter Property="BorderThickness"
                                Value="0"/>

                        <Setter Property="Template">

                            <Setter.Value>

                                <ControlTemplate
                                    TargetType="{x:Type Button}">

                                    <Border
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">

                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Setter.Value>

                        </Setter>

                    </Style>

                </StackPanel.Resources>


                <!-- CREATIVE -->

                <Button x:Name="CreativeModeButton"
                        Content="Creative Mode"
                        Click="CreativeModeButton_Click"/>


                <!-- MANUAL -->

                <Button x:Name="ManualModeButton"
                        Content="Manual Mode"
                        Click="ManualModeButton_Click"/>

            </StackPanel>


            <!-- ========================================= -->
            <!-- CENTER RESPONSE -->
            <!-- ========================================= -->

            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Panel.ZIndex="1">

                <Border Width="550"
                        Height="400"
                        BorderThickness="3"
                        BorderBrush="#D4AF37"
                        CornerRadius="8"
                        Background="#0D0D0D"
                        Opacity="0.90"/>


                <TextBox x:Name="AIResponseBox"
                         Width="520"
                         Height="360"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="White"
                         BorderThickness="0"
                         FontSize="16"
                         FontFamily="Times New Roman"
                         Padding="15"
                         TextAlignment="Left"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"/>

            </Grid>


            <!-- ========================================= -->
            <!-- AI PROVIDER PANEL -->
            <!-- ========================================= -->

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,30,35,0"
                        Width="230"
                        Panel.ZIndex="3">


                <!-- PROVIDER LABEL -->

                <TextBlock Text="AI Provider"
                           Foreground="#D4AF37"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,5"/>


                <!-- PROVIDER -->

                <ComboBox Name="AIProviderComboBox"
                          SelectionChanged="AIProviderComboBox_SelectionChanged"
                          Height="32"
                          Background="#151515"
                          Foreground="Black">

                    <ComboBoxItem Content="Local AI - Llama"/>

                    <ComboBoxItem Content="OpenAI Cloud"/>

                </ComboBox>


                <!-- API KEY LABEL -->

                <TextBlock x:Name="APIKeyLabel"
                           Text="OpenAI API Key"
                           Foreground="#D4AF37"
                           FontWeight="Bold"
                           Margin="0,15,0,5"
                           Visibility="Collapsed"/>


                <!-- API KEY -->

                <PasswordBox x:Name="APIKeyBox"
                             Height="32"
                             Background="#151515"
                             Foreground="White"
                             BorderBrush="#D4AF37"
                             Visibility="Collapsed"/>


                <!-- MODEL LABEL -->

                <TextBlock x:Name="ModelLabel"
                           Text="OpenAI Model"
                           Foreground="#D4AF37"
                           FontWeight="Bold"
                           Margin="0,15,0,5"
                           Visibility="Collapsed"/>


                <!-- MODEL -->

                <TextBox x:Name="ModelBox"
                         Height="32"
                         Text="gpt-5-mini"
                         Background="#151515"
                         Foreground="White"
                         BorderBrush="#D4AF37"
                         Padding="5"
                         Visibility="Collapsed"/>

            </StackPanel>

        </Grid>


        <!-- ========================================= -->
        <!-- BOTTOM INPUT -->
        <!-- ========================================= -->

        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,25"
                    Panel.ZIndex="2">


            <!-- USER INPUT -->

            <TextBox x:Name="UserInputBox"
                     Width="550"
                     Height="60"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Background="#151515"
                     Foreground="White"
                     BorderBrush="#D4AF37"
                     BorderThickness="1"
                     Padding="10"
                     FontSize="14"
                     FontWeight="SemiBold"
                     VerticalScrollBarVisibility="Auto"/>


            <!-- SEND -->

            <Button x:Name="SendMessageButton"
                    Content="Send a Message"
                    Width="220"
                    Height="40"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Center"
                    Background="#D4AF37"
                    Foreground="#1A1A1A"
                    FontWeight="ExtraBold"
                    BorderThickness="0"
                    Click="SendMessageButton_Click">

                <Button.Template>

                    <ControlTemplate
                        TargetType="{x:Type Button}">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Button.Template>

            </Button>

        </StackPanel>

    </Grid>

</Window>